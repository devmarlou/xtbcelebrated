<div
  class="brand-pill-block brand-pill-block--{{ block.settings.alignment }} spacing-style"
  style="{% render 'spacing-style', settings: block.settings %} font-size: {{ block.settings.font_size }}rem;"
  {{ block.shopify_attributes }}
>
  {%- render 'brand-pill', text: block.settings.text -%}
</div>

{% stylesheet %}
  .brand-pill-block {
    display: flex;
    width: 100%;
  }

  .brand-pill-block--left {
    justify-content: flex-start;
  }

  .brand-pill-block--center {
    justify-content: center;
  }

  .brand-pill-block--right {
    justify-content: flex-end;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Brand pill",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "we are xtb"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Size",
      "min": 0.8,
      "max": 2.5,
      "step": 0.1,
      "unit": "rem",
      "default": 1.2
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Brand pill"
    }
  ]
}
{% endschema %}

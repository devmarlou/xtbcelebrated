{%- doc -%}
  Short list of store perks (free shipping, voucher, coin rate) for the product page.
{%- enddoc -%}

<ul
  class="xtb-perks"
  role="list"
  {{ block.shopify_attributes }}
>
  {%- if block.settings.perk_shipping != blank -%}
    <li class="xtb-perks__item">
      <svg class="xtb-perks__icon" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><path d="M3 8h16v14H3zM19 13h6l4 5v4H19z"/><circle cx="9" cy="24" r="2.5"/><circle cx="24" cy="24" r="2.5"/></svg>
      <span>{{ block.settings.perk_shipping }}</span>
    </li>
  {%- endif -%}
  {%- if block.settings.perk_voucher != blank -%}
    <li class="xtb-perks__item">
      <svg class="xtb-perks__icon" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><path d="M4 9h24v5a2 2 0 0 0 0 4v5H4v-5a2 2 0 0 0 0-4z"/><path d="M19 9v14" stroke-dasharray="2 3"/></svg>
      <span>{{ block.settings.perk_voucher }}</span>
    </li>
  {%- endif -%}
  {%- if block.settings.perk_coins != blank -%}
    <li class="xtb-perks__item">
      <svg class="xtb-perks__icon" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><circle cx="16" cy="16" r="12"/><circle cx="16" cy="16" r="8"/><path d="M16 12v8"/></svg>
      <span>{{ block.settings.perk_coins }}</span>
    </li>
  {%- endif -%}
</ul>

{% stylesheet %}
  .xtb-perks {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 6px 18px;
    list-style: none;
    border: 2px solid var(--palette-darkest);
    border-radius: 20px;
    background: rgb(255 255 255 / 0.6);
  }

  .xtb-perks__item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-block: 12px;
    font-size: 0.9375rem;
  }

  .xtb-perks__item + .xtb-perks__item {
    border-top: 1px dashed rgb(var(--palette-darkest-rgb) / 0.25);
  }

  .xtb-perks__item p {
    margin: 0;
  }

  .xtb-perks__icon {
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    fill: none;
    stroke: var(--color-primary-button-background);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "XTB perks",
  "tag": null,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "perk_shipping",
      "label": "Shipping",
      "default": "<strong>Free shipping</strong>, worldwide"
    },
    {
      "type": "inline_richtext",
      "id": "perk_voucher",
      "label": "Voucher",
      "default": "Pay with your <strong>voucher code</strong> at checkout"
    },
    {
      "type": "inline_richtext",
      "id": "perk_coins",
      "label": "Coins",
      "default": "<strong>1 XTB Coin = $1</strong> at checkout"
    }
  ],
  "presets": [
    {
      "name": "XTB perks"
    }
  ]
}
{% endschema %}

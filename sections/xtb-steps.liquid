{%- liquid
  assign step_count = section.blocks.size
  assign columns = section.settings.columns
  if step_count < columns
    assign columns = step_count
  endif
-%}

<div class="section-background"></div>
<div
  class="section section--page-width xtb-steps spacing-style"
  style="{% render 'spacing-style', settings: section.settings %} --xtb-steps-columns: {{ columns | at_least: 1 }};"
>
  <div class="xtb-steps__inner">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank -%}
      <div class="xtb-section-head xtb-section-head--{{ section.settings.alignment }}">
        {%- if section.settings.eyebrow != blank -%}
          <p class="xtb-eyebrow">{% render 'brand-sparkle' %}{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="xtb-steps__heading">
            <span class="xtb-highlight">
              {{- section.settings.heading | escape -}}
              {%- render 'xtb-doodle', name: 'underline' -%}
            </span>
          </h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="xtb-section-head__text">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ol class="xtb-steps__list{% if section.settings.numbered == false %} xtb-steps__list--plain{% endif %}" role="list">
      {%- for block in section.blocks -%}
        <li class="xtb-steps__item xtb-sticker xtb-sticker--interactive" {{ block.shopify_attributes }}>
          <div class="xtb-steps__top">
            {%- if section.settings.numbered -%}
              <span class="xtb-steps__number" aria-hidden="true">{{ forloop.index }}</span>
            {%- endif -%}
            <span class="xtb-steps__icon" aria-hidden="true">
              {%- case block.settings.icon -%}
                {%- when 'user' -%}
                  <svg viewBox="0 0 32 32"><circle cx="16" cy="11" r="6"/><path d="M5 28c1.5-6 6-9 11-9s9.5 3 11 9"/></svg>
                {%- when 'mail' -%}
                  <svg viewBox="0 0 32 32"><rect x="4" y="7" width="24" height="18" rx="3"/><path d="M5 9l11 8 11-8"/></svg>
                {%- when 'bag' -%}
                  <svg viewBox="0 0 32 32"><path d="M6 11h20l-1.5 16h-17z"/><path d="M11 11V9a5 5 0 0 1 10 0v2"/></svg>
                {%- when 'card' -%}
                  <svg viewBox="0 0 32 32"><rect x="3" y="7" width="26" height="18" rx="3"/><path d="M3 13h26M8 20h6"/></svg>
                {%- when 'ticket' -%}
                  <svg viewBox="0 0 32 32"><path d="M4 9h24v5a2 2 0 0 0 0 4v5H4v-5a2 2 0 0 0 0-4z"/><path d="M19 9v14" stroke-dasharray="2 3"/></svg>
                {%- when 'truck' -%}
                  <svg viewBox="0 0 32 32"><path d="M3 8h16v14H3zM19 13h6l4 5v4H19z"/><circle cx="9" cy="24" r="2.5"/><circle cx="24" cy="24" r="2.5"/></svg>
                {%- when 'coin' -%}
                  <svg viewBox="0 0 32 32"><circle cx="16" cy="16" r="12"/><circle cx="16" cy="16" r="8"/><path d="M16 12v8"/></svg>
                {%- when 'clock' -%}
                  <svg viewBox="0 0 32 32"><circle cx="16" cy="16" r="12"/><path d="M16 9v7l5 3"/></svg>
                {%- when 'gift' -%}
                  <svg viewBox="0 0 32 32"><rect x="5" y="12" width="22" height="15" rx="2"/><path d="M3 12h26M16 12v15M16 12c-2-5-8-6-8-2s6 2 8 2c2 0 8 2 8-2s-6-3-8 2"/></svg>
                {%- else -%}
                  {%- render 'brand-sparkle' -%}
              {%- endcase -%}
            </span>
          </div>
          <h3 class="xtb-steps__title">{{ block.settings.title | escape }}</h3>
          {%- if block.settings.text != blank -%}
            <div class="xtb-steps__text">{{ block.settings.text }}</div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>

    {%- if section.settings.button_label != blank -%}
      <div class="xtb-actions xtb-steps__actions xtb-steps__actions--{{ section.settings.alignment }}">
        <a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
          <span class="xtb-button-content">
            {{- section.settings.button_label | escape -}}
            {%- render 'brand-sparkle' -%}
          </span>
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .xtb-steps__inner {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .xtb-steps__heading {
    font-size: clamp(2rem, 4.5vw, 3rem);
    letter-spacing: -0.025em;
    line-height: 1.05;
  }

  .xtb-steps__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media screen and (min-width: 750px) {
    .xtb-steps__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px;
    }
  }

  @media screen and (min-width: 990px) {
    .xtb-steps__list {
      grid-template-columns: repeat(var(--xtb-steps-columns), minmax(0, 1fr));
    }
  }

  .xtb-steps__item {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px;
  }

  .xtb-steps__item:nth-child(even) {
    rotate: 0.6deg;
  }

  .xtb-steps__item:nth-child(odd) {
    rotate: -0.6deg;
  }

  .xtb-steps__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
  }

  .xtb-steps__list--plain .xtb-steps__top {
    justify-content: flex-start;
  }

  .xtb-steps__number {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--xtb-red);
    color: var(--xtb-cream);
    font-size: 1.25rem;
    font-weight: 800;
  }

  .xtb-steps__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    color: var(--xtb-ink);
  }

  .xtb-steps__icon svg {
    width: 32px;
    height: 32px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .xtb-steps__icon .brand-sparkle {
    width: 26px;
    height: 26px;
    fill: var(--xtb-red);
    stroke: none;
    color: var(--xtb-red);
  }

  .xtb-steps__title {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .xtb-steps__text {
    font-size: 0.9375rem;
    opacity: 0.8;
  }

  .xtb-steps__text > * {
    margin: 0;
  }

  .xtb-steps__actions--center {
    justify-content: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "XTB steps",
  "class": "section-wrapper",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "How it works"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Three steps to your gift"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "numbered",
      "label": "Show step numbers",
      "default": true
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns on desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "user", "label": "Person" },
            { "value": "mail", "label": "Email" },
            { "value": "bag", "label": "Shopping bag" },
            { "value": "card", "label": "Card" },
            { "value": "ticket", "label": "Voucher" },
            { "value": "truck", "label": "Delivery" },
            { "value": "coin", "label": "Coin" },
            { "value": "clock", "label": "Clock" },
            { "value": "gift", "label": "Gift" }
          ],
          "default": "sparkle"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Step title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Describe this step.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "XTB steps",
      "category": "XTBCelebrated",
      "blocks": [
        { "type": "step", "settings": { "icon": "user", "title": "Sign in", "text": "<p>Use your XTB work email.</p>" } },
        { "type": "step", "settings": { "icon": "bag", "title": "Pick your swag", "text": "<p>Add what you love to your cart.</p>" } },
        { "type": "step", "settings": { "icon": "ticket", "title": "Redeem your voucher", "text": "<p>Enter your code at checkout.</p>" } }
      ]
    }
  ]
}
{% endschema %}

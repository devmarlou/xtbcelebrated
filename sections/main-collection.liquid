<script
  src="{{ 'results-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% javascript %}
  const url = new URL(window.location.href);
  if (url.hash) {
    document.addEventListener(
      'DOMContentLoaded',
      () => {
        const card = document.getElementById(url.hash.slice(1));
        if (card) {
          card.scrollIntoView({ behavior: 'instant' });
        }
      },
      { once: true }
    );
  }

  class MainCollectionPicker extends HTMLElement {
    connectedCallback() {
      this.addEventListener('click', this.onClick);
      window.addEventListener('popstate', this.onPopState);
    }

    disconnectedCallback() {
      this.removeEventListener('click', this.onClick);
      window.removeEventListener('popstate', this.onPopState);
    }

    onClick = (event) => {
      if (!(event instanceof MouseEvent) || !(event.target instanceof Element)) return;
      const link = event.target.closest('a.main-collection__pick');
      if (!(link instanceof HTMLAnchorElement)) return;
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      if (link.classList.contains('is-active')) return;
      this.load(link.href, true);
    };

    onPopState = () => {
      const active = this.querySelector('a.main-collection__pick.is-active');
      if (active instanceof HTMLAnchorElement && active.pathname === window.location.pathname) return;
      this.load(window.location.href, false);
    };

    setActive(url) {
      const path = new URL(url, window.location.origin).pathname;
      this.querySelectorAll('a.main-collection__pick').forEach((link) => {
        const active = link instanceof HTMLAnchorElement && link.pathname === path;
        link.classList.toggle('is-active', active);
        if (active) link.setAttribute('aria-current', 'page');
        else link.removeAttribute('aria-current');
      });
    }

    async load(url, push) {
      const sectionId = this.dataset.sectionId;
      const results = this.closest('results-list');
      if (!sectionId || !results) {
        window.location.assign(url);
        return;
      }

      const bannerSection = document.querySelector('.xtb-banner')?.closest('.shopify-section');
      const bannerId = bannerSection?.id.replace('shopify-section-', '');
      const sectionIds = [sectionId, bannerId].filter(Boolean);

      MainCollectionPicker.controller?.abort();
      const controller = new AbortController();
      MainCollectionPicker.controller = controller;

      this.setActive(url);
      results.classList.add('is-switching', 'is-loading');
      if (push) history.pushState({ mainCollection: true }, '', url);

      try {
        const requestUrl = new URL(url, window.location.origin);
        requestUrl.searchParams.set('sections', sectionIds.join(','));

        const [response] = await Promise.all([
          fetch(requestUrl, { signal: controller.signal }),
          new Promise((resolve) => setTimeout(resolve, 250)),
        ]);
        if (!response.ok) throw new Error(String(response.status));

        const data = await response.json();
        const parse = (id) =>
          data[id]
            ? new DOMParser().parseFromString(data[id], 'text/html').getElementById(`shopify-section-${id}`)
            : null;

        const nextResults = parse(sectionId)?.querySelector('results-list');
        if (!nextResults) throw new Error('No results');

        const nextBanner = bannerId ? parse(bannerId) : null;
        if (bannerSection && nextBanner) bannerSection.innerHTML = nextBanner.innerHTML;

        nextResults.classList.add('is-switching');
        results.replaceWith(nextResults);
        requestAnimationFrame(() => requestAnimationFrame(() => nextResults.classList.remove('is-switching')));
      } catch (error) {
        if (error instanceof DOMException && error.name === 'AbortError') return;
        window.location.assign(url);
      }
    }
  }

  if (!customElements.get('main-collection-picker')) customElements.define('main-collection-picker', MainCollectionPicker);
{% endjavascript %}

{% comment %} We always render this full-width, as the child blocks have width: page/full settings {% endcomment %}
{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

{% render 'collection-wrapper-styles' %}

{% liquid
  assign desktop_slider = false
  if section.settings.layout_type == 'carousel'
    assign desktop_slider = true
  endif

  assign mobile_layout = section.settings.mobile_layout | default: 'grid'
  assign mobile_slider = false
  if mobile_layout == 'carousel'
    assign mobile_slider = true
  endif

  assign show_grid = true
  if desktop_slider and mobile_slider
    assign show_grid = false
  endif

  assign enable_infinite_scroll = section.settings.enable_infinite_scroll
  if desktop_slider or mobile_slider
    assign enable_infinite_scroll = false
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<collection-component view-event-payload="{{ collection | standard_event_data: 'view' | escape }}">
  <results-list
    class="section product-grid-container main-collection main-collection--mobile-{{ mobile_layout }}{% if desktop_slider %} main-collection--desktop-slider{% endif %}{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
    style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px;"
    section-id="{{ section.id }}"
    infinite-scroll="{{ enable_infinite_scroll }}"
  >
    {% render 'skip-to-content-link', href: '#ResultsList', text: 'accessibility.skip_to_results_list' %}

    <div class="section-resource-list__header main-collection__header">
      {%- content_for 'block', type: '_product-list-content', id: 'static-header' -%}
    </div>

    <main-collection-picker data-section-id="{{ section.id }}">
    <nav
      class="main-collection__picker"
      style="--main-collection-header-gap: {{ section.settings.header_gap }}px;"
      aria-label="Collections"
    >
      <a
        class="main-collection__pick{% if collection.handle == 'all' %} is-active{% endif %}"
        href="{{ routes.all_products_collection_url }}"
        {% if collection.handle == 'all' %}
          aria-current="page"
        {% endif %}
      >
        All
      </a>
      {%- for picker_collection in collections -%}
        {%- if picker_collection.handle == 'all' or picker_collection.products_count == 0 -%}
          {%- continue -%}
        {%- endif -%}
        <a
          class="main-collection__pick{% if picker_collection.handle == collection.handle %} is-active{% endif %}"
          href="{{ picker_collection.url }}"
          {% if picker_collection.handle == collection.handle %}
            aria-current="page"
          {% endif %}
        >
          {{- picker_collection.title | escape -}}
        </a>
      {%- endfor -%}
    </nav>
    </main-collection-picker>

    <div
      class="collection-wrapper grid gap-style{% if section.settings.product_grid_width == 'full-width' %} collection-wrapper--grid-full-width{% endif %}"
    >
      {% content_for 'block',
        type: 'filters',
        id: 'filters',
        results: collection,
        results_size: collection.products_count
      %}

      {% assign products_per_page = 24 %}

      {% if enable_infinite_scroll == false %}
        {% assign products_per_page = section.settings.products_per_page %}
      {% endif %}

      {% paginate collection.products by products_per_page %}
        {% if show_grid %}
          {% capture children %}
            {% for product in collection.products %}
              <li
                id="{{ section.id }}-{{ product.id }}"
                class="product-grid__item product-grid__item--{{ forloop.index0 }}"
                data-page="{{ paginate.current_page }}"
                data-product-id="{{ product.id }}"
                ref="cards[]"
              >
                {% content_for 'block',
                  type: '_product-card',
                  id: 'product-card',
                  closest.product: product,
                  product_view_context: 'collection'
                %}
              </li>
            {% endfor %}
          {% endcapture %}

          {% render 'product-grid',
            section: section,
            children: children,
            products: collection.products,
            paginate: paginate,
            enable_infinite_scroll: enable_infinite_scroll
          %}
        {% endif %}

        {% if desktop_slider or mobile_slider %}
          {% capture slides %}
            {% for product in collection.products %}
              <div class="resource-list__item">
                {% content_for 'block',
                  type: '_product-card',
                  id: 'product-card',
                  closest.product: product,
                  product_view_context: 'collection'
                %}
              </div>
              {% unless forloop.last %}
                <!--@list/split-->
              {% endunless %}
            {% endfor %}
          {% endcapture %}
          {% assign slides_array = slides | strip | split: '<!--@list/split-->' %}
        {% endif %}
      {% endpaginate %}
    </div>

    {% if desktop_slider or mobile_slider %}
      {% render 'resource-list-styles' %}
      <div
        class="
          resource-list
          resource-list__carousel
          main-collection__slider
          {% unless desktop_slider %}hidden--desktop{% endunless %}
          {% unless mobile_slider %}hidden--mobile{% endunless %}
        "
        style="
          --resource-list-column-gap-desktop: {{ section.settings.columns_gap_horizontal }}px;
          --column-count: {{ section.settings.slider_columns }};
          --column-count-mobile: 1;
          --mobile-card-size: {{ section.settings.slider_mobile_card_size }};
        "
      >
        {% render 'resource-list-carousel',
          ref: 'mainCollectionCarousel',
          slides: slides_array,
          slide_count: slides_array.size,
          settings: section.settings,
          slide_width_max: '450px'
        %}
      </div>
    {% endif %}
  </results-list>
</collection-component>

{% stylesheet %}
  .main-collection__header {
    margin-block-end: 16px;
  }

  .main-collection__picker {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-block-end: var(--main-collection-header-gap, 28px);
  }

  .main-collection__pick {
    display: inline-flex;
    align-items: center;
    padding: 0.55em 1.1em;
    border: 2px solid var(--xtb-ink, currentColor);
    border-radius: 999px;
    color: var(--xtb-ink, currentColor);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .main-collection__pick:hover,
  .main-collection__pick.is-active {
    background: var(--xtb-ink, #000);
    color: var(--xtb-cream, #fff);
  }

  .main-collection :is(.collection-wrapper, .main-collection__slider) {
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .main-collection.is-switching :is(.collection-wrapper, .main-collection__slider) {
    opacity: 0;
    transform: translateY(12px);
  }

  .main-collection.is-loading .main-collection__pick {
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .main-collection :is(.collection-wrapper, .main-collection__slider) {
      transition: none;
    }
  }

  .main-collection__pick:focus-visible {
    outline: 2px solid var(--xtb-red, currentColor);
    outline-offset: 2px;
  }

  @media screen and (min-width: 750px) {
    .main-collection--desktop-slider .main-collection-grid {
      display: none;
    }
  }

  @media screen and (max-width: 749px) {
    .main-collection--mobile-carousel .main-collection-grid {
      display: none;
    }

    .main-collection--mobile-organic .product-grid {
      grid-template-columns: 1fr 1fr;
    }

    .main-collection--mobile-organic .product-grid__item:nth-of-type(3n + 1) {
      grid-column: 1 / -1;
    }
  }
{% endstylesheet %}


{% schema %}
{
  "name": "t:names.collection_container",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "organic",
          "label": "t:options.editorial"
        },
        {
          "value": "carousel",
          "label": "Slider"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "organic",
          "label": "t:options.editorial"
        },
        {
          "value": "carousel",
          "label": "Slider"
        }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "slider_columns",
      "label": "Slider columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "visible_if": "{{ section.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "select",
      "id": "slider_mobile_card_size",
      "label": "Mobile slider cards",
      "options": [
        {
          "value": "80cqw",
          "label": "t:options.one_number"
        },
        {
          "value": "44cqw",
          "label": "t:options.two_number"
        }
      ],
      "default": "80cqw",
      "visible_if": "{{ section.settings.mobile_layout == 'carousel' }}"
    },
    {
      "type": "select",
      "id": "icons_style",
      "label": "Slider arrows",
      "options": [
        {
          "value": "arrow",
          "label": "t:options.arrows"
        },
        {
          "value": "chevron",
          "label": "t:options.chevrons"
        },
        {
          "value": "none",
          "label": "t:options.none"
        }
      ],
      "default": "arrow",
      "visible_if": "{{ section.settings.layout_type == 'carousel' or section.settings.mobile_layout == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "header_gap",
      "label": "Space below collection filter",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "select",
      "id": "product_card_size",
      "label": "t:settings.card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        },
        {
          "value": "extra-large",
          "label": "t:options.extra_large"
        }
      ],
      "default": "medium",
      "visible_if": "{{ section.settings.layout_type == 'grid' }}"
    },
    {
      "type": "select",
      "id": "mobile_product_card_size",
      "label": "t:settings.mobile_card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "large",
          "label": "t:options.large"
        }
      ],
      "default": "small"
    },
    {
      "type": "checkbox",
      "id": "enable_infinite_scroll",
      "label": "t:settings.auto_load_products",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:settings.products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 24,
      "visible_if": "{{ section.settings.enable_infinite_scroll == false }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "product_grid_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "centered",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "centered"
    },
    {
      "type": "checkbox",
      "id": "full_width_on_mobile",
      "label": "t:settings.full_width_on_mobile",
      "default": true,
      "visible_if": "{{ section.settings.product_grid_width != 'full-width' }}"
    },
    {
      "type": "range",
      "id": "columns_gap_horizontal",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "columns_gap_vertical",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": []
}
{% endschema %}

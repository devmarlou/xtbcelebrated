<div class="section-background"></div>
<div
  class="section section--page-width xtb-faq spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="xtb-faq__grid">
    <div class="xtb-section-head xtb-faq__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="xtb-eyebrow">{% render 'brand-sparkle' %}{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="xtb-faq__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="xtb-section-head__text">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- render 'xtb-doodle', name: 'arrow', class: 'xtb-faq__arrow' -%}
    </div>

    <div class="xtb-faq__list">
      {%- for block in section.blocks -%}
        <details class="xtb-faq__item" {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
          <summary class="xtb-faq__question">
            <span>{{ block.settings.question | escape }}</span>
            <span class="xtb-faq__toggle" aria-hidden="true"></span>
          </summary>
          <div class="xtb-faq__answer">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .xtb-faq__grid {
    display: grid;
    gap: 32px;
  }

  @media screen and (min-width: 990px) {
    .xtb-faq__grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: 64px;
      align-items: start;
    }

    .xtb-faq__head {
      position: sticky;
      top: calc(var(--header-height, 60px) + 24px);
    }
  }

  .xtb-faq__heading {
    font-size: clamp(2rem, 4.5vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
  }

  .xtb-faq__arrow {
    width: 72px;
    height: auto;
    margin-top: 8px;
    transform: rotate(-20deg);
  }

  @media screen and (max-width: 989px) {
    .xtb-faq__arrow {
      display: none;
    }
  }

  .xtb-faq__list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .xtb-faq__item {
    border: var(--xtb-border);
    border-radius: var(--xtb-radius);
    background: var(--xtb-paper);
    transition: box-shadow 0.25s var(--xtb-ease);
  }

  .xtb-faq__item[open] {
    box-shadow: var(--xtb-shadow);
  }

  .xtb-faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 24px;
    font-size: 1.0625rem;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  .xtb-faq__question::-webkit-details-marker {
    display: none;
  }

  .xtb-faq__toggle {
    position: relative;
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--xtb-ink);
    transition: background-color 0.2s var(--xtb-ease), transform 0.3s var(--xtb-ease);
  }

  .xtb-faq__toggle::before,
  .xtb-faq__toggle::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 12px;
    height: 2px;
    border-radius: 2px;
    background: var(--xtb-cream);
    transform: translate(-50%, -50%);
  }

  .xtb-faq__toggle::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .xtb-faq__item[open] .xtb-faq__toggle {
    background: var(--xtb-red);
    transform: rotate(45deg);
  }

  .xtb-faq__answer {
    padding: 0 24px 22px;
    font-size: 0.9375rem;
    opacity: 0.85;
  }

  .xtb-faq__answer > * {
    margin: 0;
  }

  .xtb-faq__answer > * + * {
    margin-top: 0.75em;
  }

  @media (prefers-reduced-motion: reduce) {
    .xtb-faq__item,
    .xtb-faq__toggle {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "XTB FAQ",
  "class": "section-wrapper",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Questions"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Good to know"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open first question",
      "default": true
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Answer</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "XTB FAQ",
      "category": "XTBCelebrated",
      "blocks": [
        { "type": "question" },
        { "type": "question" }
      ]
    }
  ]
}
{% endschema %}

